# Interface and port to listen on.
# Keep 127.0.0.1 for local work; use 0.0.0.0 inside a container (the Dockerfile does).
HOST=127.0.0.1
PORT=3000

# Canonical public URL of this server: scheme, host and optional port only
# (no path, no trailing slash). It is the resource identifier published in the
# Protected Resource Metadata, and the default token audience.
PUBLIC_URL=http://localhost:3000

# Issuer of your authorization server. Must match the `iss` claim of the tokens
# exactly (some providers add a trailing slash). https is required, except for localhost.
AUTH_ISSUER=https://your-tenant.example.com/

# Optional. Leave empty to discover the JWKS URI from the issuer
# (OIDC discovery or RFC 8414 metadata).
AUTH_JWKS_URL=

# Optional. Expected `aud` claim. Leave empty to use PUBLIC_URL.
AUTH_AUDIENCE=

# Comma-separated browser origins allowed to call this server (CORS and DNS
# rebinding protection). Leave empty to refuse every request that carries an
# Origin header. Clients that are not browsers send no Origin and are unaffected.
# Example: the MCP Inspector UI.
ALLOWED_ORIGINS=http://localhost:6274
